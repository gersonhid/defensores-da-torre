rules_version = '2';
// Regras do Firestore — cole no console do Firebase (Firestore → Regras) ou publique com a Firebase CLI.
// Cada jogador só lê e grava os próprios dados. Ninguém lista os dados de outros jogadores pelo app;
// o administrador vê tudo pelo console do Firebase.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // perfil + dados técnicos do aparelho
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && request.resource.size() < 20000;
    }

    // progresso salvo (só contas com login gravam aqui)
    match /saves/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.data is string
        && request.resource.data.data.size() < 60000;
    }

    // reserva de nomes de usuário: cada nome pertence a uma conta, para sempre
    match /usernames/{name} {
      allow get: if signedIn();
      allow create: if signedIn()
        && name.matches('^[a-z0-9_]{3,16}$')
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
