{
  "name": "defensores-da-torre",
  "version": "0.1.0",
  "private": true,
  "description": "Jogo mobile (Android) de defesa de torre com mira por toque, heróis e cadeia de evolução.",
  "scripts": {
    "serve": "node tools/serve.js",
    "sim": "node tools/simulate.js",
    "sim:casual": "node tools/simulate.js --profile casual",
    "sim:bom": "node tools/simulate.js --profile bom",
    "sim:sem-evolucao": "node tools/simulate.js --noupgrade --levels 20",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:run": "cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor-community/admob": "^8.4.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2"
  }
}
